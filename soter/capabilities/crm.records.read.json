{
  "$contract": "soter://contracts/capability/v1",
  "contractVersion": "1.0.0",
  "id": "crm.records.read",
  "version": "1.0.0",
  "purpose": "Reads typed CRM records from the configured instance authority with normalized provenance and freshness.",
  "portability": "portable",
  "inputSchema": {
    "type": "object",
    "required": ["recordTypes"],
    "properties": {
      "recordTypes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "filters": {
        "type": "object",
        "additionalProperties": {
          "type": ["string", "number", "boolean"]
        }
      },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["records", "provenance", "observedAt"],
    "properties": {
      "records": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type", "id", "version", "fields"],
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string" },
            "version": { "type": "string" },
            "fields": { "type": "object" },
            "body": { "type": ["string", "object", "null"] }
          }
        }
      },
      "provenance": { "type": "object" },
      "observedAt": { "type": "string" }
    }
  },
  "authentication": {
    "required": true,
    "minimumScopes": ["records:read"]
  },
  "effects": ["read", "disclosure"],
  "idempotency": {
    "mode": "not-applicable",
    "key": null
  },
  "retry": {
    "safe": true,
    "maxAttempts": 3,
    "checkpoint": null
  },
  "errors": [
    "authentication",
    "authorization",
    "validation",
    "conflict",
    "rate-limit",
    "unavailable",
    "retryable",
    "not-found",
    "unknown"
  ],
  "freshness": {
    "returnsProvenance": true,
    "returnsObservedAt": true,
    "maxAgeSeconds": 300
  },
  "health": {
    "check": "Read a contained fixture record through the selected provider binding.",
    "fixture": "soter/scenarios/meeting-intake/happy-path.scenario.json",
    "containedVerification": "Prove filtering, normalized records, provenance, and not-found behavior."
  },
  "providerLimitations": []
}
