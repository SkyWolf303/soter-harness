{
  "$contract": "soter://contracts/context-record-model/v1",
  "contractVersion": "1.0.0",
  "id": "model.context.crm.records",
  "pack": "context.crm",
  "version": "0.1.0",
  "subject": "crm.records",
  "recordTypes": [
    {
      "id": "policy",
      "summary": "An index record that names an authoritative policy definition.",
      "fields": [
        { "id": "name", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The exact human-readable policy title." }
      ],
      "content": { "kind": "none", "requiredOnCreate": false, "summary": "Policy bodies are loaded through explicit portable document sources." },
      "deduplicationFields": ["name"]
    },
    {
      "id": "organization",
      "summary": "An organization participating in CRM relationships and work.",
      "fields": [
        { "id": "name", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The organization display name." },
        { "id": "organizationType", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The configured organization classification." },
        { "id": "status", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The portable organization lifecycle state." },
        { "id": "tags", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Portable organization classification tags." },
        { "id": "projectUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related project resource identities.", "reference": { "subject": "project", "identity": "resource-uri" } },
        { "id": "contactUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related contact resource identities.", "reference": { "subject": "person", "identity": "resource-uri" } }
      ],
      "content": { "kind": "none", "requiredOnCreate": false, "summary": "Organization records have no portable body content." },
      "deduplicationFields": ["name"]
    },
    {
      "id": "person",
      "summary": "A CRM contact whose authority and relationships remain explicit.",
      "fields": [
        { "id": "name", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The contact display name." },
        { "id": "email", "type": "string", "format": "email", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The contact email address when known." },
        { "id": "role", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The contact role classification." },
        { "id": "status", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The contact lifecycle state." },
        { "id": "disposition", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The configured relationship disposition." },
        { "id": "authority", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Explicit authority labels assigned to this contact." },
        { "id": "organizationUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related organization resource identities.", "reference": { "subject": "organization", "identity": "resource-uri" } }
      ],
      "content": { "kind": "none", "requiredOnCreate": false, "summary": "Contact records have no portable body content." },
      "deduplicationFields": ["email", "name"]
    },
    {
      "id": "project",
      "summary": "A bounded body of work related to organizations and tasks.",
      "fields": [
        { "id": "name", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The project display name." },
        { "id": "projectType", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The configured project classification." },
        { "id": "status", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The portable project lifecycle state." },
        { "id": "organizationUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related organization resource identities.", "reference": { "subject": "organization", "identity": "resource-uri" } },
        { "id": "taskUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related task resource identities.", "reference": { "subject": "task", "identity": "resource-uri" } }
      ],
      "content": { "kind": "none", "requiredOnCreate": false, "summary": "Project records have no portable body content." },
      "deduplicationFields": ["name"]
    },
    {
      "id": "task",
      "summary": "A bounded work item that can be related to one or more projects.",
      "fields": [
        { "id": "title", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The task title describing the intended work." },
        { "id": "status", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The portable task lifecycle state." },
        { "id": "context", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The configured work-context classification." },
        { "id": "projectUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related project resource identities.", "reference": { "subject": "project", "identity": "resource-uri" } }
      ],
      "content": { "kind": "none", "requiredOnCreate": false, "summary": "Task records have no portable body content." },
      "deduplicationFields": ["title"]
    },
    {
      "id": "meeting",
      "summary": "A meeting record anchored to one canonical recording identity.",
      "fields": [
        { "id": "title", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The meeting display title." },
        { "id": "meetingType", "type": "string", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "The configured meeting classification." },
        { "id": "recordingUri", "type": "string", "format": "resource-uri", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The exact canonical recording resource identity." },
        { "id": "organizationUris", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Exact related organization resource identities.", "reference": { "subject": "organization", "identity": "resource-uri" } },
        { "id": "participantIds", "type": "string-list", "requiredOnCreate": false, "nullable": true, "mutable": true, "summary": "Provider-scoped participant identities that are not CRM contact IDs.", "reference": { "subject": "meeting.participant", "identity": "provider-person-id" } }
      ],
      "content": { "kind": "none", "requiredOnCreate": false, "summary": "Meeting records have no portable body content." },
      "deduplicationFields": ["recordingUri", "title"]
    },
    {
      "id": "meeting-summary",
      "summary": "A transcript-grounded document linked to its canonical source meeting.",
      "fields": [
        { "id": "title", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The human-readable summary title." },
        { "id": "documentType", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The document classification for meeting summaries." },
        { "id": "description", "type": "string", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "A bounded plain-language summary description." },
        { "id": "link", "type": "string", "format": "resource-uri", "requiredOnCreate": true, "nullable": false, "mutable": true, "summary": "The canonical source recording link used for attribution and deduplication." }
      ],
      "content": { "kind": "markdown", "requiredOnCreate": true, "summary": "The transcript-grounded meeting summary body in Markdown." },
      "deduplicationFields": ["link", "title"]
    }
  ],
  "limitations": [
    "This model defines portable meaning and shapes; it does not assert that any selected provider maps every record or field.",
    "Provider-scoped meeting participant identities do not become CRM contact identities without a separate resolution contract.",
    "Policy bodies remain external canonical sources and are not embedded in policy index records."
  ]
}
