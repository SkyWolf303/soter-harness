{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/host-tool-call/v1",
  "title": "Soter host-dispatched tool call",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "runId",
    "createdAt",
    "completedAt",
    "state",
    "configurationLockFingerprint",
    "graphFingerprint",
    "host",
    "provider",
    "capability",
    "authority",
    "declaredEffects",
    "policyDecisions",
    "inputFingerprint",
    "transport",
    "arguments",
    "argumentsFingerprint",
    "responseFingerprint",
    "outputFingerprint",
    "error",
    "secretValuesExcluded"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/host-tool-call/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^toolcall\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "createdAt": { "type": "string", "minLength": 20 },
    "completedAt": { "type": ["string", "null"], "minLength": 20 },
    "state": { "enum": ["requested", "completed", "failed", "blocked"] },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "implementation", "version", "containment"],
      "properties": {
        "pack": { "type": "string", "minLength": 3 },
        "implementation": {
          "type": "string",
          "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "containment": { "enum": ["connected", "canary", "live"] }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "authority": { "type": "string", "minLength": 3 },
    "declaredEffects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    },
    "policyDecisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect", "mode", "decision", "reason"],
        "properties": {
          "effect": { "$ref": "#/$defs/effect" },
          "mode": { "enum": ["allow", "confirm", "prohibit"] },
          "decision": { "enum": ["allowed", "confirmed", "blocked"] },
          "reason": { "type": "string", "minLength": 3 }
        }
      }
    },
    "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "server", "operation", "tool"],
      "properties": {
        "protocol": { "const": "mcp" },
        "server": { "type": "string", "minLength": 1 },
        "operation": { "type": ["string", "null"], "minLength": 1 },
        "tool": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "arguments": { "type": ["object", "null"] },
    "argumentsFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "responseFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outputFingerprint": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "error": {
      "type": ["object", "null"]
    },
    "secretValuesExcluded": { "const": true }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    }
  }
}
