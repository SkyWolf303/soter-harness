{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/provider-mapping/v1",
  "title": "Soter provider record mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "pack",
    "provider",
    "version",
    "settingsDefinition",
    "capabilities",
    "recordTypes",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/provider-mapping/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^mapping\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "pack": {
      "type": "string",
      "pattern": "^integration\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "provider": {
      "type": "string",
      "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "settingsDefinition": {
      "type": "string",
      "pattern": "^settings\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "recordTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "fields"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["portable", "provider", "decode"],
              "properties": {
                "portable": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]*$"
                },
                "provider": { "type": "string", "minLength": 1 },
                "decode": { "enum": ["scalar", "json"] }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8 }
    }
  }
}
