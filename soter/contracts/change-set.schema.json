{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/change-set/v1",
  "title": "Soter reviewable change set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "runId", "createdAt",
    "configurationLockFingerprint", "state", "scopeFingerprint", "operations",
    "approvalId", "transaction", "verification"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/change-set/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^changeset\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "runId": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "fingerprint",
        "contextSnapshotId",
        "contextSnapshotFingerprint"
      ],
      "properties": {
        "kind": { "const": "automation-decision" },
        "id": {
          "type": "string",
          "pattern": "^decision\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "contextSnapshotId": {
          "type": "string",
          "pattern": "^context\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "contextSnapshotFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "state": { "enum": ["proposed", "approved", "executing", "committed", "rolled-back", "failed"] },
    "scopeFingerprint": { "$ref": "#/$defs/fingerprint" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "authority", "reason", "input", "inputFingerprint", "state", "effectId", "outputFingerprint", "error"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability": { "enum": ["crm.records.create", "crm.records.update"] },
          "authority": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 8 },
          "input": { "type": "object" },
          "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
          "state": { "enum": ["pending", "passed", "failed", "rolled-back"] },
          "effectId": { "type": ["string", "null"] },
          "outputFingerprint": { "type": ["string", "null"] },
          "error": { "type": ["object", "null"] }
        }
      }
    },
    "approvalId": { "type": ["string", "null"] },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointFingerprint", "state", "rollbackState", "restoredFingerprint"],
      "properties": {
        "checkpointFingerprint": { "$ref": "#/$defs/fingerprint" },
        "state": { "enum": ["not-started", "committed", "rolled-back", "failed"] },
        "rollbackState": { "enum": ["not-required", "passed", "failed"] },
        "restoredFingerprint": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "effectId", "criteria", "observedFingerprint"],
      "properties": {
        "state": { "$ref": "#/$defs/resultState" },
        "effectId": { "type": ["string", "null"] },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "observedFingerprint": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resultState": { "enum": ["passed", "failed", "stale", "unknown", "skipped", "not-applicable"] }
  }
}
