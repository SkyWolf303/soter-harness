{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/connected-operation-batch/v1",
  "title": "Soter approval-bound connected operation batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract", "contractVersion", "id", "runId", "createdAt",
    "configurationLockFingerprint", "changeSet", "state", "executable",
    "blockers", "operations", "batchFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/connected-operation-batch/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^batch\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "runId": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "configurationLockFingerprint": { "$ref": "#/$defs/fingerprint" },
    "changeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeFingerprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^changeset\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "scopeFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "state": { "enum": ["proposed", "blocked"] },
    "executable": { "type": "boolean" },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 8 } },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "sequence", "capability", "authority", "provider",
          "input", "inputFingerprint", "precondition", "verification",
          "contentVerification", "recovery"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "capability": { "enum": ["crm.records.create", "crm.records.update"] },
          "authority": { "type": "string", "minLength": 3 },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pack", "implementation", "version"],
            "properties": {
              "pack": { "type": "string", "minLength": 3 },
              "implementation": { "type": "string", "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
              "version": { "$ref": "#/$defs/version" }
            }
          },
          "input": { "type": "object" },
          "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
          "precondition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "readInput", "expectedVersion", "expectedCount"],
            "properties": {
              "kind": { "enum": ["deduplication-absent", "expected-version"] },
              "readInput": { "type": "object" },
              "expectedVersion": { "type": ["string", "null"] },
              "expectedCount": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "recordType", "recordId", "expectedFieldsFingerprint"],
            "properties": {
              "kind": { "const": "record-fields-match" },
              "recordType": { "type": "string", "minLength": 1 },
              "recordId": { "type": ["string", "null"] },
              "expectedFieldsFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          },
          "contentVerification": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["kind", "capability", "expectedTitle", "expectedBodyFingerprint"],
            "properties": {
              "kind": { "const": "exact-document-content" },
              "capability": { "const": "documents.content.read" },
              "expectedTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
              "expectedBodyFingerprint": { "$ref": "#/$defs/fingerprint" }
            }
          },
          "recovery": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "reason"],
            "properties": {
              "mode": {
                "enum": [
                  "restore-prior-fields",
                  "terminal-idempotent-create",
                  "manual-required"
                ]
              },
              "reason": { "type": "string", "minLength": 8 }
            }
          }
        }
      }
    },
    "batchFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
