{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/capability-provider/v1",
  "title": "Soter capability provider implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "pack",
    "version",
    "containment",
    "runtime",
    "capabilities",
    "authorities",
    "effects",
    "mappings",
    "fixtures",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/capability-provider/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "pack": {
      "type": "string",
      "pattern": "^integration\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": { "$ref": "#/$defs/version" },
    "containment": {
      "enum": ["fixture", "contained", "connected", "canary", "live"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "module"],
      "properties": {
        "engine": { "enum": ["node", "mcp"] },
        "module": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "prepareExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "completeExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probePrepareExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probeCompleteExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probePlanExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probeStepCompleteExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "probeFinalizeExport": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "probeTools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "subject"],
        "properties": {
          "role": {
            "enum": ["definition", "instance", "provider", "projection", "evidence"]
          },
          "subject": { "type": "string", "minLength": 1 }
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/effect" }
    },
    "mappings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixtures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    }
  }
}
