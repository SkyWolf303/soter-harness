{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/approval/v2",
  "title": "Soter exact connected operation-batch approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["$contract", "contractVersion", "id", "runId", "createdAt", "expiresAt", "actor", "decision", "scope", "reason"],
  "properties": {
    "$contract": { "const": "soter://contracts/approval/v2" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^approval\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "runId": { "type": "string", "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "createdAt": { "type": "string", "minLength": 20 },
    "expiresAt": { "type": "string", "minLength": 20 },
    "actor": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approved", "rejected"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeSetId", "changeSetFingerprint", "operationBatchId", "operationBatchFingerprint", "effects"],
      "properties": {
        "changeSetId": { "type": "string", "minLength": 1 },
        "changeSetFingerprint": { "$ref": "#/$defs/fingerprint" },
        "operationBatchId": { "type": "string", "minLength": 1 },
        "operationBatchFingerprint": { "$ref": "#/$defs/fingerprint" },
        "effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["write", "destructive"] } }
      }
    },
    "reason": { "type": "string", "minLength": 8 }
  },
  "$defs": { "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
