{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/configuration-view/v1",
  "title": "Soter explainable configuration view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "basis",
    "configuration",
    "host",
    "systems",
    "dependencies",
    "bindings",
    "sources",
    "authorities",
    "effectPolicies",
    "states",
    "viewFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/configuration-view/v1" },
    "contractVersion": { "const": "1.0.0" },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lockFingerprint", "graphFingerprint", "resolver"],
      "properties": {
        "kind": { "enum": ["configuration", "lock"] },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" },
        "graphFingerprint": { "$ref": "#/$defs/fingerprint" },
        "resolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "core.resolver" },
            "version": { "$ref": "#/$defs/version" }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "fingerprint", "configuredDefaultHost"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "configuredDefaultHost": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "version",
        "selectionSource",
        "selectionReason",
        "summary",
        "conformance",
        "limitations",
        "projections"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "selectionSource": { "enum": ["configuration", "override"] },
        "selectionReason": { "type": "string", "minLength": 12 },
        "summary": { "type": "string", "minLength": 20 },
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxLevel", "scenarios"],
          "properties": {
            "maxLevel": {
              "enum": ["static", "graph", "fixture", "agent", "contained", "canary", "monitored"]
            },
            "scenarios": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8 }
        },
        "projections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"] }
            }
          }
        }
      }
    },
    "systems": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/system" }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/binding" }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "authorities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/authority" }
    },
    "effectPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "disclosure", "write", "dispatch", "destructive"],
      "properties": {
        "read": { "$ref": "#/$defs/effectPolicy" },
        "disclosure": { "$ref": "#/$defs/effectPolicy" },
        "write": { "$ref": "#/$defs/effectPolicy" },
        "dispatch": { "$ref": "#/$defs/effectPolicy" },
        "destructive": { "$ref": "#/$defs/effectPolicy" }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "ready", "verified", "healthy", "basis"],
      "properties": {
        "valid": { "enum": ["passed", "failed", "unknown", "stale"] },
        "ready": { "enum": ["passed", "failed", "unknown", "stale"] },
        "verified": { "enum": ["passed", "failed", "unknown", "stale"] },
        "healthy": { "enum": ["passed", "failed", "unknown", "stale"] },
        "basis": { "type": "string", "minLength": 20 }
      }
    },
    "viewFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "optional", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 12 }
      }
    },
    "capabilityProvision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "layer",
        "summary",
        "releaseStage",
        "evidenceMaturity",
        "selection",
        "capabilities",
        "effects",
        "requiredBy",
        "artifactCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "$ref": "#/$defs/version" },
        "layer": { "enum": ["kernel", "core", "context", "automation", "integration"] },
        "summary": { "type": "string", "minLength": 20 },
        "releaseStage": { "enum": ["experimental", "preview", "stable", "deprecated"] },
        "evidenceMaturity": { "enum": ["declared", "fixture-proven", "contained-proven", "live-proven"] },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "reason"],
          "properties": {
            "source": { "enum": ["base", "user", "bundle", "recommendation", "dependency", "binding"] },
            "reason": { "type": "string", "minLength": 12 }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires", "provides"],
          "properties": {
            "requires": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/capabilityRequirement" }
            },
            "provides": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/capabilityProvision" }
            }
          }
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/effect" }
        },
        "requiredBy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "artifactCount": { "type": "integer", "minimum": 0 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "version", "optional", "reason"],
      "properties": {
        "from": { "type": "string", "minLength": 3 },
        "to": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 12 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "capabilityVersion", "providerPack", "providerVersion", "authorities", "effects", "reason"],
      "properties": {
        "capability": { "type": "string", "minLength": 3 },
        "capabilityVersion": { "$ref": "#/$defs/version" },
        "providerPack": { "type": "string", "minLength": 3 },
        "providerVersion": { "$ref": "#/$defs/version" },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/effect" }
        },
        "reason": { "type": "string", "minLength": 12 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "capabilityVersion", "authority", "input", "inputFingerprint", "readiness", "consumers", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "capability": { "type": "string", "minLength": 3 },
        "capabilityVersion": { "$ref": "#/$defs/version" },
        "authority": { "type": "string", "minLength": 3 },
        "input": { "type": "object" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "reason"],
          "properties": {
            "mode": { "enum": ["probe-read", "runtime-only"] },
            "reason": { "type": "string", "minLength": 20 }
          }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pack", "purpose", "subjects", "reason"],
            "properties": {
              "pack": { "type": "string", "minLength": 3 },
              "purpose": { "type": "string", "minLength": 3 },
              "subjects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "reason": { "type": "string", "minLength": 20 }
            }
          }
        },
        "reason": { "type": "string", "minLength": 20 }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "subject", "uri", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "role": { "enum": ["definition", "instance", "provider", "projection", "evidence"] },
        "subject": { "type": "string", "minLength": 3 },
        "uri": { "type": "string", "minLength": 3 },
        "reason": { "type": "string", "minLength": 12 }
      }
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "enum": ["allow", "confirm", "prohibit"] },
        "reason": { "type": "string", "minLength": 8 }
      }
    }
  }
}
