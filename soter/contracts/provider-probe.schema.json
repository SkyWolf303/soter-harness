{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/provider-probe/v1",
  "title": "Soter connected provider probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "probedAt",
    "validUntil",
    "configuration",
    "provider",
    "credentials",
    "reachability",
    "authorities",
    "capabilities",
    "secretValuesExcluded",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/provider-probe/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^probe\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "probedAt": { "type": "string", "minLength": 20 },
    "validUntil": { "type": "string", "minLength": 20 },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lockFingerprint"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "lockFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "implementation", "version", "containment"],
      "properties": {
        "pack": { "type": "string", "minLength": 3 },
        "implementation": {
          "type": "string",
          "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "$ref": "#/$defs/version" },
        "containment": { "const": "connected" }
      }
    },
    "credentials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secretRefId", "state", "details"],
        "properties": {
          "secretRefId": {
            "type": "string",
            "pattern": "^secret-ref\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "state": { "$ref": "#/$defs/probeState" },
          "details": { "type": "string", "minLength": 3 }
        }
      }
    },
    "reachability": { "$ref": "#/$defs/check" },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "details"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^authority\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "state": { "$ref": "#/$defs/probeState" },
          "details": { "type": "string", "minLength": 3 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "method", "details"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "state": { "$ref": "#/$defs/probeState" },
          "method": {
            "enum": ["metadata", "read-only", "permission-introspection"]
          },
          "details": { "type": "string", "minLength": 3 }
        }
      }
    },
    "secretValuesExcluded": { "const": true },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8 }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "probeState": {
      "enum": ["passed", "failed", "unknown"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "details"],
      "properties": {
        "state": { "$ref": "#/$defs/probeState" },
        "details": { "type": "string", "minLength": 3 },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
