{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/provider-mapping/v3",
  "title": "Soter context-bound typed provider record mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "pack",
    "provider",
    "version",
    "contextModel",
    "settingsDefinition",
    "capabilities",
    "recordTypes",
    "limitations"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/provider-mapping/v3" },
    "contractVersion": { "const": "3.0.0" },
    "id": {
      "type": "string",
      "pattern": "^mapping\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "pack": {
      "type": "string",
      "pattern": "^integration\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "provider": {
      "type": "string",
      "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": { "$ref": "#/$defs/version" },
    "contextModel": {
      "type": "string",
      "pattern": "^model\\.context\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "settingsDefinition": {
      "type": "string",
      "pattern": "^settings\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "recordTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "capabilities", "fields"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["crm.records.read", "crm.records.create", "crm.records.update"]
            }
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/field" }
          },
          "content": { "$ref": "#/$defs/content" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8 }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable", "provider", "providerType", "decode"],
      "properties": {
        "portable": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "provider": { "type": "string", "minLength": 1 },
        "providerType": { "type": "string", "minLength": 1 },
        "decode": { "enum": ["scalar", "json"] }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable", "provider", "providerType"],
      "properties": {
        "portable": { "const": "body" },
        "provider": { "type": "string", "minLength": 1 },
        "providerType": { "enum": ["markdown"] }
      }
    }
  }
}
