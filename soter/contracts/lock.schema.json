{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/lock/v1",
  "title": "Soter resolved configuration lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "configuration",
    "resolver",
    "host",
    "packs",
    "dependencies",
    "capabilities",
    "bindings",
    "authorities",
    "effectPolicies",
    "settings",
    "projections",
    "graphFingerprint"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/lock/v1" },
    "contractVersion": { "const": "1.0.0" },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "fingerprint"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "core.resolver" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "adapter", "version", "manifestFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "manifestFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "layer",
          "releaseStage",
          "evidenceMaturity",
          "source",
          "reason",
          "manifestFingerprint",
          "artifacts"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" },
          "layer": {
            "enum": ["kernel", "core", "context", "automation", "integration"]
          },
          "releaseStage": {
            "enum": ["experimental", "preview", "stable", "deprecated"]
          },
          "evidenceMaturity": {
            "enum": ["declared", "fixture-proven", "contained-proven", "live-proven"]
          },
          "source": {
            "enum": ["base", "user", "bundle", "recommendation", "dependency", "binding"]
          },
          "reason": { "type": "string", "minLength": 12 },
          "manifestFingerprint": { "$ref": "#/$defs/fingerprint" },
          "artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "fingerprint"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "role": {
                  "enum": ["definition", "implementation", "projection", "evaluation", "fixture", "migration"]
                },
                "fingerprint": { "$ref": "#/$defs/fingerprint" }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "version", "optional", "reason"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 12 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "contractFingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" },
          "contractFingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "capabilityVersion",
          "providerPack",
          "providerVersion",
          "authorities",
          "effects",
          "reason"
        ],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "capabilityVersion": { "$ref": "#/$defs/version" },
          "providerPack": { "type": "string", "minLength": 1 },
          "providerVersion": { "$ref": "#/$defs/version" },
          "authorities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "effects": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/effect" }
          },
          "reason": { "type": "string", "minLength": 12 }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "subject", "uri", "reason", "declarationFingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["definition", "instance", "provider", "projection", "evidence"]
          },
          "subject": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 12 },
          "declarationFingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "effectPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "disclosure", "write", "dispatch", "destructive"],
      "properties": {
        "read": { "$ref": "#/$defs/effectPolicy" },
        "disclosure": { "$ref": "#/$defs/effectPolicy" },
        "write": { "$ref": "#/$defs/effectPolicy" },
        "dispatch": { "$ref": "#/$defs/effectPolicy" },
        "destructive": { "$ref": "#/$defs/effectPolicy" }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "fingerprint"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["instructions", "skills", "tools", "lifecycle", "configuration"]
          },
          "fingerprint": { "$ref": "#/$defs/fingerprint" }
        }
      }
    },
    "graphFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "effect": {
      "enum": ["read", "disclosure", "write", "dispatch", "destructive"]
    },
    "effectPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "enum": ["allow", "confirm", "prohibit"] },
        "reason": { "type": "string", "minLength": 8 }
      }
    }
  }
}
