{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/operation-plan/v1",
  "title": "Soter sequential capability operation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "runId",
    "createdAt",
    "mode",
    "failurePolicy",
    "reason",
    "steps"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/operation-plan/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^plan\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "createdAt": { "type": "string", "minLength": 20 },
    "mode": { "const": "sequential" },
    "failurePolicy": { "const": "stop" },
    "reason": { "type": "string", "minLength": 12 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "authority",
          "providerImplementation",
          "input",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "capability": { "type": "string", "minLength": 3 },
          "authority": {
            "type": "string",
            "pattern": "^authority\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "providerImplementation": {
            "type": "string",
            "pattern": "^provider\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "input": { "type": "object" },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
