{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soter://contracts/migration/v1",
  "title": "Soter migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$contract",
    "contractVersion",
    "id",
    "source",
    "slice",
    "items"
  ],
  "properties": {
    "$contract": { "const": "soter://contracts/migration/v1" },
    "contractVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "source": { "type": "string", "minLength": 3 },
    "slice": { "type": "string", "minLength": 3 },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "targetPath", "targetPack", "state", "bridge"],
        "properties": {
          "sourcePath": { "type": "string", "minLength": 1 },
          "targetPath": { "type": "string", "minLength": 1 },
          "targetPack": { "type": "string", "minLength": 3 },
          "state": {
            "enum": ["current", "mapped", "bridged", "migrated", "retired"]
          },
          "bridge": { "type": "string", "minLength": 12 },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
