{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "aegean":      { "dark": "#3E7CB1", "light": "#1D5C8A" },
    "aegeanDeep":  { "dark": "#16324F", "light": "#0F2A44" },
    "gold":        { "dark": "#D9A441", "light": "#B8860B" },
    "goldBright":  { "dark": "#F2C14E", "light": "#9A7B0A" },
    "ink":         { "dark": "#E8EDF2", "light": "#1B2530" },
    "mist":        { "dark": "#8CA3B8", "light": "#5C7288" },
    "bg":          { "dark": "#0D1620", "light": "#F7FAFC" },
    "bgPanel":     { "dark": "#122238", "light": "#E9F0F6" },
    "bgElement":   { "dark": "#16324F", "light": "#DDE8F1" },
    "red":         { "dark": "#E5534B", "light": "#B3261E" },
    "green":       { "dark": "#57AB5A", "light": "#2E7D32" }
  },
  "theme": {
    "primary": "aegean",
    "secondary": "mist",
    "accent": "gold",
    "error": "red",
    "warning": "goldBright",
    "success": "green",
    "info": "aegean",
    "text": "ink",
    "textMuted": "mist",
    "background": "bg",
    "backgroundPanel": "bgPanel",
    "backgroundElement": "bgElement",
    "border": "aegeanDeep",
    "borderActive": "gold",
    "borderSubtle": "aegeanDeep",
    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "mist",
    "diffHunkHeader": "mist",
    "diffHighlightAdded": "green",
    "diffHighlightRemoved": "red",
    "diffAddedBg": { "dark": "#14301C", "light": "#DDF0DE" },
    "diffRemovedBg": { "dark": "#33171A", "light": "#F6DFDE" },
    "diffContextBg": "bgPanel",
    "diffLineNumber": "bgElement",
    "diffAddedLineNumberBg": { "dark": "#14301C", "light": "#DDF0DE" },
    "diffRemovedLineNumberBg": { "dark": "#33171A", "light": "#F6DFDE" },
    "markdownText": "ink",
    "markdownHeading": "aegean",
    "markdownLink": "aegean",
    "markdownLinkText": "gold",
    "markdownCode": "goldBright",
    "markdownBlockQuote": "mist",
    "markdownEmph": "gold",
    "markdownStrong": "gold",
    "markdownHorizontalRule": "aegeanDeep",
    "markdownListItem": "aegean",
    "markdownListEnumeration": "aegean",
    "markdownImage": "aegean",
    "markdownImageText": "mist",
    "markdownCodeBlock": "ink",
    "syntaxComment": "mist",
    "syntaxKeyword": "aegean",
    "syntaxFunction": "goldBright",
    "syntaxVariable": "ink",
    "syntaxString": "gold",
    "syntaxNumber": "goldBright",
    "syntaxType": "aegean",
    "syntaxOperator": "mist",
    "syntaxPunctuation": "mist"
  }
}
